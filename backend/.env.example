NODE_ENV="development"
PORT=3000

DATABASE_URL="postgresql://user:password@localhost:5432/event_manager?schema=public"

REDIS_URL="redis://localhost:6379"

JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
FRONTEND_URL="http://localhost:3001"
# Comma-separated CORS allow-list — defaults to FRONTEND_URL alone if unset.
CORS_ORIGINS="http://localhost:3001"

SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# Error tracking (docs/INFRASTRUCTURE.md §6) — leave empty to disable, the
# app boots fine without it and just logs a warning.
SENTRY_DSN=""

CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""

PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_PUBLIC_KEY=""
PAYDUNYA_TOKEN=""
PAYDUNYA_MODE="test"
PAYDUNYA_CALLBACK_URL="http://localhost:3000/payments/webhooks/paydunya"

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="Zen Events <no-reply@zenevents.sn>"
