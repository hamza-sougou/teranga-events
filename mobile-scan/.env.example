# Copy to .env (gitignored) and fill in for your machine.
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time — never put
# a secret here, only the API's base URL.
#
# "localhost" does NOT work from an emulator or a physical device — it
# resolves to the device itself, not your dev machine:
#   - Android emulator: use the special alias 10.0.2.2
#       EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#   - Physical device on the same Wi-Fi: use your machine's LAN IP
#       EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
